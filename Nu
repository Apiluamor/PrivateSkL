                        if gameProcessed then return end
                        if input.UserInputType == Enum.UserInputType.MouseMovement then
                            cameraLocked = false
                        end
                    end)
                end
        
                function M.set(on)
                    on = on and true or false
                    if M.enabled == on then return end
                    M.enabled = on
                    if on then
                        startLoops()
                    else
                        stopLoops()
                    end
                end
        
                function M.isEnabled()
                    return M.enabled
                end
        
                return M
            end)()
        if _G.ExtraAntiAP and _G.AntiAdmin and _G.AntiAdmin.set then
