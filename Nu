    local FV = { enabled = false, value = math.clamp(tonumber(_G.ExtraFOVValue) or 80, 1, 120) }
    local conn = nil
    local original = nil

    local function apply()
        if conn then conn:Disconnect(); conn = nil end
        local cam = workspace.CurrentCamera
        if FV.enabled then
            if cam and original == nil then original = cam.FieldOfView end
            conn = RunService.RenderStepped:Connect(function()
                local c = workspace.CurrentCamera
