                            if n ~= "" and t:find(n, 1, true) then
                                return plot
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    local function getAdminTextBoxAB()
        local AdminGui = PlayerGui:FindFirstChild("AdminPanel")
        if not AdminGui then return nil end
        local panel = AdminGui:FindFirstChild("AdminPanel")
        if not panel then return nil end
        local commandBox = panel:FindFirstChild("CommandBox")
        if not commandBox then return nil end
        return commandBox:FindFirstChild("TextBox")
    end

    local function fireBalloonCmd(targetName)
        local TextBox = getAdminTextBoxAB()
        if not TextBox then return false end
        local fullCmd = ";balloon " .. targetName
        local originalVisible = TextBox.Visible
        TextBox.Visible = false
        TextBox.Text = fullCmd
        task.wait(0.02)
        if getconnections then
            pcall(function()
                for _, conn in pairs(getconnections(TextBox.FocusLost)) do
                    if conn.Fire then conn:Fire(true)
                    elseif conn.Function then conn.Function(true) end
                end
            end)
        else
            pcall(function()
                if firesignal then firesignal(TextBox.FocusLost, true) end
            end)
        end
        task.wait(0.02)
        TextBox.Text = ""
        TextBox.Visible = originalVisible
        return true
    end

    local function triggerBalloonOnTarget(targetPlayer)
        if not targetPlayer or not targetPlayer.Parent then return end
        if type(execCmd) == "function" then
            pcall(function() execCmd("balloon", targetPlayer.Name) end)
            return
        end
        fireBalloonCmd(targetPlayer.Name)
    end

    -- stealStart[uid] = tick cuando empezó a robar (para no tirar al instante del grab)
    local BL = { active = {}, stealStart = {}, cooldown = 2.0 }
    _G._175_BL = BL
    local GRAB_IGNORE = 1.1 -- segundos tras empezar el robo: NO tirar (es el grab)
    local NEAR_HOME = 42    -- distancia a SU base = "casi llega"

    local function autoBalloonHeartbeat()
        if thisScriptStopped or not _G.AutoBalloon then return end
        local myPlot = getMyPlotAB()
        if not myPlot then return end

        local now = tick()
        for _, p in pairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local uid = p.UserId

            local isStealing = p:GetAttribute("StealingPlayer") == true
            if not isStealing then
                BL.active[uid] = nil
                BL.stealStart[uid] = nil
                continue
            end

            -- marca inicio del robo (primer frame con StealingPlayer)
            if not BL.stealStart[uid] then
                BL.stealStart[uid] = now
            end

            -- NO tirar al agarrar: espera un poco
            if (now - BL.stealStart[uid]) < GRAB_IGNORE then
                continue
            end

            local character = p.Character
            if not character then continue end
            local root = character:FindFirstChild("HumanoidRootPart")
                or character:FindFirstChild("Torso")
            if not root then continue end

            -- Si sigue dentro de TU plot, aún está robando / saliendo: no es "casi en su base"
            if isInsidePlot(root.Position, myPlot, 4) then
                continue
            end

            -- ¿Casi en SU base?
            local enemyPlot = getEnemyPlot(p)
            local nearHome = false
            if enemyPlot then
                local c = plotCenter(enemyPlot)
                if c and (c - root.Position).Magnitude <= NEAR_HOME then
                    nearHome = true
                end
                if isInsidePlot(root.Position, enemyPlot, 12) then
                    nearHome = true
                end
            else
                -- sin plot detectado: si ya salió de la tuya y lleva rato robando, tirar
                if (now - BL.stealStart[uid]) >= 2.5 then
                    nearHome = true
                end
            end

            if not nearHome then continue end

            local last = BL.active[uid]
            if last and (now - last) < BL.cooldown then continue end
            BL.active[uid] = now
            task.spawn(function()
                triggerBalloonOnTarget(p)
                task.wait(0.12)
                triggerBalloonOnTarget(p)
            end)
        end
    end

    local conn = RunService.Heartbeat:Connect(autoBalloonHeartbeat)
    table.insert(ActiveConnections, conn)
    print("[175] Auto Balloon: solo cuando casi llegan a SU base")
end)




