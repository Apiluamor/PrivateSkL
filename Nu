-- ============ DATOS DEL MEJOR BRAINROT (logica extraida de DNK hub) ============
-- Lee la tabla real de cada base (Synchronizer) + Animals / Mutations / Traits,
-- calcula el $/s con la misma formula y devuelve el #1 (mayor generacion).
local BestData = { list = {}, ready = false }
do
    local RS = ReplicatedStorage
    local Synchronizer, AnimalsData, MutationsData, TraitsData
    local plotCache = {}
    local iconCache = {}

    local function toAssetUrl(v)
        if v == nil then return "" end
        if type(v) == "number" then
            return "rbxthumb://type=Asset&id=" .. tostring(v) .. "&w=150&h=150"
        end
        if type(v) ~= "string" or v == "" then return "" end
        if v:find("rbxassetid://") or v:find("rbxthumb://") or v:find("http") then return v end
        local n = tonumber(v:match("%d+"))
        if n and n > 100 then
            return "rbxthumb://type=Asset&id=" .. tostring(n) .. "&w=150&h=150"
        end
        return ""
    end

    local function resolveAnimalIcon(info, index)
        if index and iconCache[index] then return iconCache[index] end
        local url = ""
        if type(info) == "table" then
            for _, key in ipairs({ "Icon", "Image", "ImageId", "AssetId", "Thumbnail", "Render",
                "ViewportImage", "RarityIcon", "DisplayIcon", "PetImage", "IconImage" }) do
                url = toAssetUrl(info[key])
                if url ~= "" then break end
            end
            if url == "" then
                for k, v in pairs(info) do
                    if type(v) == "string" and (v:find("rbxasset") or v:find("rbxthumb")) then
                        url = v
                        break
                    end
                    if type(v) == "number" and v > 10000 then
                        local ks = tostring(k):lower()
                        if ks:find("icon") or ks:find("image") or ks:find("asset") or ks:find("thumb") then
                            url = toAssetUrl(v)
                            if url ~= "" then break end
                        end
                    end
                end
            end
        end
        if index then iconCache[index] = url end
        return url
    end

    local function iconFromModel(model)
        if not model then return "" end
        local best = ""
        pcall(function()
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("Decal") and type(d.Texture) == "string" and d.Texture ~= ""
                    and not d.Texture:find("rbxasset://textures") then
                    best = d.Texture
                    return
                end
                if d:IsA("MeshPart") and type(d.TextureID) == "string" and d.TextureID ~= "" then
                    best = d.TextureID
                    return
                end
                if d:IsA("ImageLabel") and type(d.Image) == "string" and d.Image ~= "" then
                    best = d.Image
                    return
                end
            end
        end)
        return best
    end

    local function channelTable(name)
        local okc, res = pcall(function()
            local prev = getthreadidentity and getthreadidentity() or nil
            if setthreadidentity then setthreadidentity(8) end
            local tb = Synchronizer:GetTableFromChannel(name)
            if prev and setthreadidentity then pcall(setthreadidentity, prev) end
            return tb
        end)
        if okc and type(res) == "table" then return res end
        return nil
    end

    local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td",
        "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg", "Uvg", "Dvg", "Tvg" }
    local function fmtGen(v)
        local xG = math.abs(v)
        local mag = math.floor(math.log(math.max(1, xG), 1000))
        local suf = SUFFIX[mag + 1] or ("e+" .. mag)
        local scaled = v * (10 ^ 1 / 1000 ^ mag)
        local shown = math.floor(scaled) / 10 ^ 1
        return ((("%.1f"):format(shown)):gsub("%.?0+$", "")) .. suf
    end

    -- generacion de un brainrot (formula del slice / DNK)
    local function genOf(index, mutation, traits)
        local a = AnimalsData[index]
        if not a then return 0 end
        local gen = a.Generation or (a.Price or 0) * 0.1
        local mult = 1
        if mutation and mutation ~= "None" then
            local m = MutationsData[mutation]
            if m and m.Modifier then mult = mult + m.Modifier end
        end
        local sleepy = false
        if type(traits) == "table" then
            for _, tr in ipairs(traits) do
                if tr == "Sleepy" then
                    sleepy = true
                else
                    local tt = TraitsData[tr]
                    if tt and tt.MultiplierModifier then mult = mult + tt.MultiplierModifier end
                end
            end
        end
        local v = math.round(gen * mult)
        if sleepy then v = math.round(v * 0.5) end
        return v
    end

    local function ownerIsMe(owner)
        if not owner then return false end
        if typeof(owner) == "Instance" then return owner == LocalPlayer end
        if type(owner) == "string" then return owner == LocalPlayer.Name end
        if type(owner) == "number" then return owner == LocalPlayer.UserId end
        return false
    end
    local function ownerName(owner)
        return typeof(owner) == "Instance" and owner.Name or tostring(owner)
    end

    local function findPrompt(plot, spawn)
        local att = spawn and spawn:FindFirstChild("PromptAttachment")
        if att then
            for _, pr in ipairs(att:GetChildren()) do
                if pr:IsA("ProximityPrompt") and pr.Enabled and tostring(pr.ActionText):find("Steal") then
                    return pr
                end
            end
        end
        if spawn then
            local sp = spawn.Position
            local bestPr, bestD = nil, 8
            for _, d in ipairs(plot:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and tostring(d.ActionText):find("Steal") then
                    local par = d.Parent
                    local pos
                    if par and par:IsA("BasePart") then pos = par.Position
                    elseif par and par:IsA("Attachment") and par.Parent and par.Parent:IsA("BasePart") then
                        pos = par.Parent.Position
                    end
                    if pos then
                        local dist = math.sqrt((pos.X - sp.X) ^ 2 + (pos.Z - sp.Z) ^ 2)
                        if dist < bestD then bestPr, bestD = d, dist end
                    end
                end
            end
            return bestPr
        end
        return nil
    end

    local function signature(animalList, owner)
        local s = ownerName(owner)
        for k, v in pairs(animalList) do
            if type(v) == "table" then
                s = s .. tostring(k) .. tostring(v.Index) .. tostring(v.Mutation)
                if type(v.Traits) == "table" then
                    for _, tr in ipairs(v.Traits) do s = s .. tostring(tr) end
                end
            end
        end
        return s
    end

    local function buildPlot(plot)
        local ch = channelTable(plot.Name)
        if not ch then plotCache[plot.Name] = nil; return nil end
        local owner, animalList = ch.Owner, ch.AnimalList
        if not owner or ownerIsMe(owner) or type(animalList) ~= "table" then
            plotCache[plot.Name] = nil
            return nil
        end
        local okm, mine = pcall(function() return isMyPlot(plot) end)
        if okm and mine then plotCache[plot.Name] = nil; return nil end

        local sig = signature(animalList, owner)
        local cached = plotCache[plot.Name]
        local recs
        if cached and cached.sig == sig then
            recs = cached.recs
        else
            recs = {}
            for slot, data in pairs(animalList) do
                if type(data) == "table" then
                    local info = AnimalsData[data.Index]
                    if info then
                        local gv = genOf(data.Index, data.Mutation, data.Traits)
                        if gv >= 1 then
                            local mut = data.Mutation or "None"
                            local traits = {}
                            if type(data.Traits) == "table" then
                                for _, tr in ipairs(data.Traits) do table.insert(traits, tostring(tr)) end
                            end
                            table.insert(recs, {
                                name = info.DisplayName or tostring(data.Index),
                                genText = "$" .. fmtGen(gv) .. "/s",
                                genValue = gv,
                                mutation = mut,
                                traits = traits,
                                owner = ownerName(owner),
                                plotName = plot.Name,
                                slot = tostring(slot),
                                uid = plot.Name .. "_" .. tostring(slot),
                                icon = resolveAnimalIcon(info, data.Index),
                                index = data.Index,
                            })
                        end
                    end
                end
            end
            plotCache[plot.Name] = { sig = sig, recs = recs }
        end
        -- posicion / prompt / foto (se re-resuelven si el podio cambio)
        local pods = plot:FindFirstChild("AnimalPodiums")
        for _, r in ipairs(recs) do
            local podium = pods and pods:FindFirstChild(r.slot)
            if podium then
                if not r.icon or r.icon == "" then
                    local fm = iconFromModel(podium)
                    if fm ~= "" then
                        r.icon = fm
                        if r.index then iconCache[r.index] = fm end
                    end
                end
                if not (r.prompt and r.prompt.Parent) then
                    local base = podium:FindFirstChild("Base")
                    local spawn = base and (base:FindFirstChild("Spawn") or base:FindFirstChildWhichIsA("BasePart"))
                    if spawn then
                        r.pos = spawn.Position
                        r.prompt = findPrompt(plot, spawn)
                    end
                end
            end
        end
        return recs
    end

