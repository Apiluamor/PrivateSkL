            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local best, bd = nil, math.huge
            for _, d in ipairs(base:GetDescendants()) do
                if d:IsA("ProximityPrompt") and (string.find(d.ObjectText, "Allow") or string.find(d.ObjectText, "Disallow")) then
                    local part = promptPart(d)
                    local dist = (hrp and part) and (hrp.Position - part.Position).Magnitude or math.huge
                    if not best or dist < bd then best, bd = d, dist end
                end
            end
            return best
        end

