-- UIScale en cada hijo directo + tamano compensado para que siga llenando la ventana.
_G._175_ScaleContent = function(frame, s)
    s = math.clamp(s, 0.6, 3)
    for _, ch in ipairs(frame:GetChildren()) do
        if ch:IsA("GuiObject") and ch.Name ~= "175_ResizeGrip" and ch.Name ~= "ResizeGrip" and ch.Name ~= "GlassClip" then
            local us = ch:FindFirstChild("_175Scale")
            if not us then
                us = Instance.new("UIScale")
                us.Name = "_175Scale"
                us.Parent = ch
                local sz = ch.Size
                ch:SetAttribute("_175BX", sz.X.Scale)
                ch:SetAttribute("_175OX", sz.X.Offset)
                ch:SetAttribute("_175BY", sz.Y.Scale)
                ch:SetAttribute("_175OY", sz.Y.Offset)
            end
            us.Scale = s
            ch.Size = UDim2.new(
                (ch:GetAttribute("_175BX") or 0) / s, (ch:GetAttribute("_175OX") or 0) / s,
                (ch:GetAttribute("_175BY") or 0) / s, (ch:GetAttribute("_175OY") or 0) / s)
        end
    end
end
