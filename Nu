                for i = 1, #url do hash = (hash * 31 + string.byte(url, i)) % 100000000 end
                fileName = "175_snd_" .. tostring(hash) .. ".mp3"

                local data = nil
                local requestFn = (syn and syn.request) or (http and http.request) or http_request or request
                if requestFn then
                    local res = requestFn({
                        Url = url,
                        Method = "GET",
                        Headers = { ["User-Agent"] = "Mozilla/5.0", ["Accept"] = "*/*" },
                    })
                    if res then
                        data = res.Body or res.body or res.Data
                    end
                end
                if (not data or #tostring(data) < 100) then
                    pcall(function() data = game:HttpGet(url) end)
                end
                if not data or #tostring(data) < 100 then
                    warn("[175] No se pudo descargar sonido:", url)
                    return
                end
                if not writefile then
                    warn("[175] writefile no disponible")
                    return
                end
                writefile(fileName, data)
                if getcustomasset then
                    assetId = getcustomasset(fileName)
                    soundAssetCache[url] = assetId
                else
                    warn("[175] getcustomasset no disponible")
                    return
                end
            end

            local s = Instance.new("Sound")
            s.Name = "175_NotifySound"
            s.SoundId = assetId
            s.Volume = vol or 1
            s.Looped = false
            s.Parent = SoundService
            s:Play()
            -- por si Loaded tarda
            if not s.IsLoaded then
                pcall(function() s.Loaded:Wait() end)
                pcall(function() s:Play() end)
            end
            task.delay(dur or 6, function()
                pcall(function() s:Stop(); s:Destroy() end)
            end)
        end)
        if not ok then
            warn("[175] playUrlSound error:", err)
        end
    end)
end

