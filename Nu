local function startFlashCooldown(secs)
    secs = math.max(1, tonumber(secs) or FLASH_CD or 20)
    -- reiniciar si ya había uno
    flashOnCd = true
    _G._175_FlashSpent = false
    flashCdLeft = secs
    local gen = (flashCdGen or 0) + 1
    flashCdGen = gen

    pcall(function()
        if type(stopFlashBlink) == "function" then stopFlashBlink() end
    end)

    local lbl = getFlashLabel()
    if lbl then
        lbl.Text = tostring(secs) .. "s"
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    pcall(function()
        if FLASHTP then FLASHTP.BackgroundColor3 = Color3.fromRGB(20, 20, 20) end
        if flashAccent then flashAccent.BackgroundColor3 = Color3.fromRGB(180, 180, 180) end
    end)
    print("[175] Flash gastado → contador", secs, "s")

    task.spawn(function()
        while flashCdLeft > 0 and not thisScriptStopped and flashCdGen == gen do
            local tleft = math.ceil(flashCdLeft)
            local l = getFlashLabel()
            if l then
                l.Text = tostring(tleft) .. "s"
                l.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
            pcall(function()
                if FLASHTP then FLASHTP.BackgroundColor3 = Color3.fromRGB(20, 20, 20) end
                if flashAccent then flashAccent.BackgroundColor3 = Color3.fromRGB(180, 180, 180) end
            end)
            task.wait(0.25)
            flashCdLeft = flashCdLeft - 0.25
        end
        if flashCdGen ~= gen then return end
        flashOnCd = false
        flashCdLeft = 0
        local l = getFlashLabel()
        if l then
            l.Text = "FLASH [F]"
            l.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        pcall(function()
            if FLASHTP then FLASHTP.BackgroundColor3 = C.card end
            if flashAccent then flashAccent.BackgroundColor3 = C.stroke or C.accent end
        end)
        -- Listo para flash de nuevo (parpadea)
        pcall(function()
            if type(startFlashBlink) == "function" then startFlashBlink() end
        end)
        print("[175] Flash LISTO")
    end)
end
_G._175_StartFlashCooldown = startFlashCooldown
