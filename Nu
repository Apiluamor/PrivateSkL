-- Mejor brainrot ahora: datos reales (DNK) con cache de 0.5s; si los modulos no
-- cargaron, usa el metodo anterior.
local function getBestNow()
    local now = os.clock()
    if now - lastBestCalc >= 0.5 then
        lastBestCalc = now
        cachedBest = nil
        local okc, rec = pcall(BestData.compute)
        if okc and rec and rec.prompt and rec.prompt.Parent then
            cachedBest = { prompt = rec.prompt, name = rec.name, value = rec.genText, rec = rec }
        elseif not BestData.ready then
            local okl, p, n, v = pcall(findBestBrainrotLegacy)
            if okl and p and p.Parent then
                cachedBest = { prompt = p, name = n, value = v }
            end
        end
    end
    if cachedBest and cachedBest.prompt and not cachedBest.prompt.Parent then cachedBest = nil end
    return cachedBest
end

local function bestEspText(best, dist)
    local lines = { tostring(best.name or "Pet"), tostring(best.value or "?") }
    local rec = best.rec
    if rec then
        local mut = prettyMutation(rec.mutation)
        if mut then table.insert(lines, mut) end
    end
    table.insert(lines, "[" .. dist .. "m]")
    return table.concat(lines, "\n")
end

