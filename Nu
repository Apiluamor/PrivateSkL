local function scanForBrainrots()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return false end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") and not _agMyPlot(plot) then
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then
                for _, pod in ipairs(pods:GetChildren()) do
                    local base = pod:FindFirstChild("Base")
                    local sp = base and base:FindFirstChild("Spawn")
                    local att = sp and sp:FindFirstChild("PromptAttachment")
                    if att then
                        for _, child in ipairs(att:GetChildren()) do
                            if child:IsA("ProximityPrompt") and _agIsValidStealPrompt(child) then
                                return true
                            end
                        end
                    end
                    if sp then
                        for _, child in ipairs(sp:GetDescendants()) do
                            if child:IsA("ProximityPrompt") and _agIsValidStealPrompt(child) then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function getPromptForPodium(plot, slot)
    if not plot or not slot then return nil end
    local pods = plot:FindFirstChild("AnimalPodiums")
    if not pods then return nil end
    local podium = pods:FindFirstChild(tostring(slot))
    if not podium then return nil end
    local base = podium:FindFirstChild("Base")
    if base then
        local spawn = base:FindFirstChild("Spawn")
        if spawn then
            local att = spawn:FindFirstChild("PromptAttachment")
            if att then
                for _, pr in ipairs(att:GetChildren()) do
                    if pr:IsA("ProximityPrompt") and _agIsValidStealPrompt(pr) then
                        return pr
                    end
                end
            end
            for _, pr in ipairs(spawn:GetDescendants()) do
                if pr:IsA("ProximityPrompt") and _agIsValidStealPrompt(pr) then
                    return pr
                end
            end
        end
        for _, pr in ipairs(base:GetDescendants()) do
            if pr:IsA("ProximityPrompt") and _agIsValidStealPrompt(pr) then
                return pr
            end
        end
    end
    for _, pr in ipairs(podium:GetDescendants()) do
        if pr:IsA("ProximityPrompt") and _agIsValidStealPrompt(pr) then
            return pr
        end
    end
    return nil
end

local function findTargetPrompt()
    -- Prefer selected prompt if valid and in range
    if Steal.SelectedEntry and Steal.SelectedEntry.prompt then
        local prompt = Steal.SelectedEntry.prompt
        if prompt and prompt.Parent and prompt:IsA("ProximityPrompt") and _agIsValidStealPrompt(prompt) then
            local plot = Steal.SelectedEntry.plot
            if plot and plot.Parent and not _agMyPlot(plot) then
                return prompt
            end
        end
        Steal.SelectedEntry = nil
    end

    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not root then return nil end

    -- Prefer global selectedPrompt if close
    if selectedPrompt and selectedPrompt.Parent and _agIsValidStealPrompt(selectedPrompt) then
        local pos = nil
        pcall(function()
            local p = selectedPrompt.Parent
            if p and p:IsA("Attachment") then pos = p.WorldPosition
            elseif p and p:IsA("BasePart") then pos = p.Position end
        end)
        if pos and (root.Position - pos).Magnitude <= Steal.StealRadius then
            return selectedPrompt
        end
    end

    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local nearest, dist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") and not _agMyPlot(plot) then
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then
                for _, pod in ipairs(pods:GetChildren()) do
                    local base = pod:FindFirstChild("Base")
                    local sp = base and base:FindFirstChild("Spawn")
                    if sp then
                        local d = (sp.Position - root.Position).Magnitude
                        if d <= Steal.StealRadius and d < dist then
                            local found = getPromptForPodium(plot, tonumber(pod.Name) or pod.Name)
                            if found then
                                nearest, dist = found, d
                            else
                                for _, pr in ipairs(sp:GetDescendants()) do
                                    if pr:IsA("ProximityPrompt") and _agIsValidStealPrompt(pr) then
                                        nearest, dist = pr, d
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local function _promptDist(prompt)
    local char = LocalPlayer.Character
    if not char then return math.huge end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not root then return math.huge end
    local part = prompt.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if part and part:IsA("BasePart") then
        return (part.Position - root.Position).Magnitude
    end
    local ok, wp = pcall(function()
        if prompt.Parent and prompt.Parent:IsA("Attachment") then
            return prompt.Parent.WorldPosition
        end
        return nil
    end)
    if ok and wp then
        return (wp - root.Position).Magnitude
    end
    return math.huge
end

local function executeAutoGrabSteal(prompt)
    if AG.paused then return end
    -- Sweet-style: no bloquear con isStealing largo
    if not prompt or not prompt.Parent or not _agIsValidStealPrompt(prompt) then return end
    if spFrame and _G._175_FlashActive then
        pcall(function() if _G._175_AutoGrabScreenGui then _G._175_AutoGrabScreenGui.Enabled = true end end)
        spFrame.Visible = true
    end

    if not Steal.Data[prompt] then
        Steal.Data[prompt] = { hold = {}, trigger = {}, ready = true }
        if getconnections then
            pcall(function()
                for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                    if c.Function then table.insert(Steal.Data[prompt].hold, c.Function) end
                end
                for _, c in ipairs(getconnections(prompt.Triggered)) do
                    if c.Function then table.insert(Steal.Data[prompt].trigger, c.Function) end
                end
            end)
        end
    end
    local data = Steal.Data[prompt]
    if not data.ready then return end
    data.ready = false
    isStealing = true
    stealStartTime = tick()

    if Steal.Mode == "half" then
        task.spawn(function()
            for _, fn in ipairs(data.hold) do task.spawn(fn) end
            pcall(function()
                if fireproximityprompt then fireproximityprompt(prompt, Steal.HalfHoldMin) end
            end)
            pcall(function() if prompt.InputHoldBegin then prompt:InputHoldBegin() end end)
            task.wait(Steal.HalfHoldMin)
            local inRange = _promptDist(prompt) <= Steal.HalfFireRange
            while true do
                local el = tick() - stealStartTime
                if el > Steal.HalfHoldMax or not prompt.Parent then break end
                if _promptDist(prompt) <= Steal.HalfFireRange then
                    if not inRange then task.wait(Steal.HalfEntryDelay) end
                    for _, fn in ipairs(data.trigger) do task.spawn(fn) end
                    pcall(function()
                        if fireproximityprompt then fireproximityprompt(prompt) end
                    end)
                    pcall(function() if prompt.InputHoldEnd then prompt:InputHoldEnd() end end)
                    break
                end
                task.wait()
            end
            task.wait(0.05)
            data.ready = true
            isStealing = false
        end)
    else
        task.spawn(function()
            for _, fn in ipairs(data.hold) do task.spawn(fn) end
            pcall(function()
                if fireproximityprompt then fireproximityprompt(prompt, Steal.StealDuration) end
            end)
            pcall(function() if prompt.InputHoldBegin then prompt:InputHoldBegin() end end)
            local el = 0
            while el < Steal.StealDuration do
                el = el + task.wait()
            end
            for _, fn in ipairs(data.trigger) do task.spawn(fn) end
            pcall(function()
                if fireproximityprompt then fireproximityprompt(prompt) end
            end)
            pcall(function() if prompt.InputHoldEnd then prompt:InputHoldEnd() end end)
            task.wait(0.05)
            data.ready = true
            isStealing = false
        end)
    end
end

