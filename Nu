        local ok, err = pcall(function()
            local packages = RS:WaitForChild("Packages", 15)
            local datas = RS:WaitForChild("Datas", 15)
            if not packages or not datas then error("sin Packages / Datas") end
            Synchronizer = require(packages:WaitForChild("Synchronizer", 15))
            AnimalsData = require(datas:WaitForChild("Animals", 15))
            MutationsData = require(datas:WaitForChild("Mutations", 15))
            TraitsData = require(datas:WaitForChild("Traits", 15))
            BestData.ready = true
        end)
        if not ok then warn("[175] ESP Best (datos): " .. tostring(err) .. " -> uso el metodo anterior") end
    end)

    -- Devuelve el brainrot con mas $/s que se pueda robar (o nil)
    function BestData.compute()
        if not BestData.ready then return nil end
        local plots = Workspace:FindFirstChild("Plots")
        if not plots then return nil end
        local all, seen = {}, {}
        for _, plot in ipairs(plots:GetChildren()) do
            seen[plot.Name] = true
            local recs = buildPlot(plot)
            if recs then for _, r in ipairs(recs) do table.insert(all, r) end end
        end
        for name in pairs(plotCache) do
            if not seen[name] then plotCache[name] = nil end
        end
        table.sort(all, function(a, b) return a.genValue > b.genValue end)
        BestData.list = all
        for _, r in ipairs(all) do
            if r.prompt and r.prompt.Parent then return r end
        end
        return nil
    end
end

