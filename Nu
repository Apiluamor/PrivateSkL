-- ===== Vidrio + colores en TODAS las GUI del script (tambien las que se abren despues) =====
task.spawn(function()
    task.wait(1.5)
    local function isDarkNeutral(c)
        local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
        local mx, mn = math.max(r, g, b), math.min(r, g, b)
        return mx <= 70 and (mx - mn) <= 14
    end
    local function glassify(inst)
        pcall(function()
            if inst:IsA("UIStroke") then
                -- bordes de tarjetas/botones: finos y suaves (no el borde de vidrio con degradado)
                local par = inst.Parent
                if par and not par:GetAttribute("_175Glass") and not inst:FindFirstChildOfClass("UIGradient")
                    and inst.Thickness <= 2 then
                    inst.Transparency = math.max(inst.Transparency, 0.5)
                end
                return
            end
            if (inst:IsA("Frame") or inst:IsA("TextButton") or inst:IsA("ScrollingFrame") or inst:IsA("TextBox"))
                and inst.BackgroundTransparency < 0.3 and isDarkNeutral(inst.BackgroundColor3) then
                inst.BackgroundTransparency = 0.25
            end
        end)
    end
    local manual = { ["175 Flash & Block"] = true, ["175SettingsFloat"] = true, ["175BrainrotsFloat"] = true, ["HugoHubBanner"] = true }
    local skip = { ["175_SpendFx"] = true, ["175_CoinDropFx"] = true, ["175_StealIntro"] = true,
        ["175_WrongPlace"] = true, ["175_VerityInsult"] = true, ["175_OwlToggle"] = true,
        ["BaseStateToasts"] = true, ["175_StealAlert"] = true }
    local extra = { ["HugoHubBanner"] = true, ["Ext_BaseToggle"] = true, ["DropBrainrotGui"] = true,
        ["StealProgressScreenGui"] = true, ["BestBrainrotNotify"] = true }
    local function wanted(name)
        name = tostring(name)
        if skip[name] then return false end
        return name:sub(1, 3) == "175" or extra[name] == true
    end
    local function handle(gui)
        if not gui:IsA("ScreenGui") or not wanted(gui.Name) then return end
        if gui:GetAttribute("_175Hooked") then return end
        gui:SetAttribute("_175Hooked", true)
        local function pass()
            pcall(function()
                if not manual[gui.Name] then _G._175_GlassGui(gui) end
                for _, d in ipairs(gui:GetDescendants()) do glassify(d) end
            end)
        end
        pass() -- ahora mismo (antes del primer frame)
        local dirty = false
        local function schedule()
            if dirty then return end
            dirty = true
            task.defer(function() dirty = false; pass() end) -- mismo frame, antes de dibujar
        end
        gui.ChildAdded:Connect(schedule)
        gui.DescendantAdded:Connect(function(d)
            glassify(d)
            schedule()
        end)
        task.delay(0.5, pass); task.delay(2, pass)
    end
    local parents = {}
    pcall(function() if gethui then table.insert(parents, gethui()) end end)
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    table.insert(parents, PlayerGui)
    task.spawn(function() -- red de seguridad: GUI cuyo nombre se pone despues de crearse
        while not thisScriptStopped do
            task.wait(1)
            for _, par in ipairs(parents) do
                pcall(function() for _, g in ipairs(par:GetChildren()) do handle(g) end end)
            end
        end
    end)
    for _, par in ipairs(parents) do
        pcall(function()
            for _, g in ipairs(par:GetChildren()) do handle(g) end
            par.ChildAdded:Connect(function(g) handle(g) end)
        end)
    end
end)


