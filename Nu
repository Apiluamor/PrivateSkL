local function playerHasAP(plr)
    if not plr then return false end
    pcall(function()
        if plr:GetAttribute("AdminCommands") == true then return end
    end)
    if plr:GetAttribute("AdminCommands") == true then return true end
    if plr:GetAttribute("HasAdmin") == true then return true end
    if plr:GetAttribute("Admin") == true then return true end
    local function scan(container)
        if not container then return false end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") or t:IsA("HopperBin") then
                local n = string.lower(tostring(t.Name or ""))
                if n:find("admin", 1, true) or n == "ap" or n:find("panel", 1, true)
                    or n:find("comando", 1, true) or n:find("command", 1, true) then
                    return true
                end
            end
        end
        return false
    end
    if scan(plr:FindFirstChild("Backpack")) then return true end
    if scan(plr:FindFirstChild("StarterGear")) then return true end
    if plr.Character and scan(plr.Character) then return true end
    return false
end

