    local function podiumOfPrompt(prompt)
        if not prompt or not prompt.Parent then return nil end
        local attachment = prompt.Parent
        local spawnPoint = attachment and attachment.Parent
        local podium = spawnPoint and spawnPoint.Parent
        if podium and podium.Name == "Base" then podium = podium.Parent end
        return podium
    end
    local findModelRaw
    local modelCache, nextScan = {}, {}
    local function findModelNear(podium, plot)
        local spawnPos = nil
        pcall(function()
            local base = podium:FindFirstChild("Base") or podium
            local sp = base:FindFirstChild("Spawn")
            local att = sp and sp:FindFirstChild("PromptAttachment")
            spawnPos = (att and att:IsA("Attachment") and att.WorldPosition) or (sp and sp:IsA("BasePart") and sp.Position) or nil
        end)
        if not spawnPos then return nil end
        local names = {}
        for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do names[pl.Name] = true end
        local best, bd = nil, 8
        for _, v in ipairs(plot:GetDescendants()) do
            if v:IsA("Model") and not names[v.Name] then
                local rp = v.PrimaryPart or v:FindFirstChild("RootPart") or v:FindFirstChildWhichIsA("BasePart")
                if rp then
                    local d = (rp.Position - spawnPos).Magnitude
                    if d < bd then bd = d; best = v end
                end
            end
        end
        return best
    end
    local function findModel(podium, plot)
        local c = modelCache[podium]
        if c and c.Parent then return c end
        local m = findModelRaw(podium)
        if not m and plot and tick() >= (nextScan[podium] or 0) then
            nextScan[podium] = tick() + 3
            m = findModelNear(podium, plot)
        end
        modelCache[podium] = m
        return m
    end
    function findModelRaw(podium)
        for _, c in ipairs(podium:GetChildren()) do
            if c:IsA("Model") and c:FindFirstChildOfClass("Humanoid") then return c end
        end
        for _, d in ipairs(podium:GetDescendants()) do
            if d:IsA("Humanoid") and d.Parent:IsA("Model") then return d.Parent end
        end
        return nil
    end
