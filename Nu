    local function pickTricks(list, count)
        -- filtra recientes
        local pool = {}
        for _, item in ipairs(list) do
            if not wasRecent(item.name) then
                table.insert(pool, item)
            end
        end
        if #pool == 0 then
            pool = {}
            for _, item in ipairs(list) do table.insert(pool, item) end
        end
        local out = {}
        count = math.min(count or 1, #pool)
        for _ = 1, count do
            if #pool == 0 then break end
            local idx = math.random(1, #pool)
            table.insert(out, pool[idx])
            rememberTrick(pool[idx].name)
            table.remove(pool, idx)
        end
        return out
    end

