-- ===== GANCHO (logica del Sabcom): se tira hacia adelante al suelo, sin jalon ni sonido =====
do
    local function muteAndStopPull(tool, hrp)
        if tool then
            for _, s in ipairs(tool:GetDescendants()) do
                if s:IsA("Sound") then
                    pcall(function() s.Volume = 0; s:Stop() end)
                elseif s:IsA("Beam") then
                    pcall(function() s.Enabled = false; s.Attachment0 = nil end)
                end
            end
        end
        if hrp then
            local fp = hrp:FindFirstChild("FlightPower")
            if fp then fp:Destroy() end
            if not _G._175_FlashMoving then   -- una vez que empieza el vuelo ya no se frena la velocidad
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end
    local function holdNoPull(tool, hrp, seconds)
        local t0 = os.clock()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            muteAndStopPull(tool, hrp)
            if os.clock() - t0 > seconds then
                conn:Disconnect()
                muteAndStopPull(tool, hrp)
            end
        end)
    end
    local function disparar(tool, pos, alvo, char)
        local refs = (getgenv and getgenv().__175PMRefs) or _G.__175PMRefs
        if not refs then
            refs = {}
            pcall(function()
                local mouse = require(game:GetService("ReplicatedStorage").Packages.PlayerMouse)
                if type(mouse) == "table" then refs[1] = mouse end
            end)
            if getgenv then getgenv().__175PMRefs = refs end
            _G.__175PMRefs = refs
        end
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        muteAndStopPull(tool, hrp)
        local mira = CFrame.new(pos)
        local antes = {}
        for i, tt in ipairs(refs) do
            antes[i] = { rawget(tt, "Hit"), rawget(tt, "Target") }
            pcall(function() tt.Hit = mira; tt.Target = alvo end)
        end
        local ok = pcall(function() tool:Activate() end)
        if not ok then ok = pcall(function() firesignal(tool.Activated) end) end
        muteAndStopPull(tool, hrp)
        holdNoPull(tool, hrp, 0.6)
        task.spawn(function()
            for _ = 1, 4 do
                for _, tt in ipairs(refs) do
                    pcall(function() tt.Hit = mira; tt.Target = alvo end)
                end
                muteAndStopPull(tool, hrp)
                RunService.Heartbeat:Wait()
            end
            for i, tt in ipairs(refs) do
                local a = antes[i]
                pcall(function() tt.Hit = a[1]; tt.Target = a[2] end)
            end
            muteAndStopPull(tool, hrp)
        end)
        return ok
    end
    -- value = Vector3 hacia donde se va (direccion). Devuelve true si el gancho salio.
    _G._175_SabHook = function(value)
        local eu = LocalPlayer
        local char = eu and eu.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local tool = char:FindFirstChild("Grapple Hook")
        if not tool then
            local bp = eu:FindFirstChildOfClass("Backpack")
            local t2 = bp and bp:FindFirstChild("Grapple Hook")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not t2 or not hum then return false end
            pcall(function() hum:EquipTool(t2) end)
            local t0 = os.clock()
            repeat
                RunService.Heartbeat:Wait()
                char = eu.Character
                tool = char and char:FindFirstChild("Grapple Hook")
            until tool or os.clock() - t0 > 0.5
            if not tool then return false end
            hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end
        end
        local dir
        if typeof(value) == "Vector3" then
            dir = value - hrp.Position
            dir = Vector3.new(dir.X, 0, dir.Z)
        end
        if not dir or dir.Magnitude < 1 then
            local lv = hrp.CFrame.LookVector
            dir = Vector3.new(lv.X, 0, lv.Z)
        end
        if dir.Magnitude < 0.01 then return false end
        dir = dir.Unit
        local par = RaycastParams.new()
        par.FilterType = Enum.RaycastFilterType.Exclude
        par.FilterDescendantsInstances = { char }
        local pos, alvo, melhorM
        for _, d in ipairs({ 9, 10, 11, 12, 13, 14, 16, 18, 21, 24, 28, 32, 36, 40, 45 }) do
            local origem = hrp.Position + dir * d + Vector3.new(0, 3, 0)
            local hit = workspace:Raycast(origem, Vector3.new(0, -60, 0), par)
            if hit then
                local m = (hit.Position - hrp.Position).Magnitude
                if m >= 5 and m <= 80 and (not melhorM or m < melhorM) then
                    pos, alvo, melhorM = hit.Position, hit.Instance, m
                end
            end
        end
        if not pos then
            for _, d in ipairs({ 11, 14, 18, 24, 32, 42, 48 }) do
                local hit = workspace:Raycast(hrp.Position, dir * d, par)
                if hit then
                    local m = (hit.Position - hrp.Position).Magnitude
                    if m >= 5 and m <= 80 and (not melhorM or m < melhorM) then
                        pos, alvo, melhorM = hit.Position, hit.Instance, m
                    end
                end
            end
        end
        if not pos or not alvo then
            -- fallback: busca piso mas cerca / mas lejos
            for _, d in ipairs({ 5, 7, 15, 22, 30, 40, 55, 70 }) do
                local origem = hrp.Position + dir * d + Vector3.new(0, 5, 0)
                local hit = workspace:Raycast(origem, Vector3.new(0, -80, 0), par)
                if hit then
                    pos, alvo = hit.Position, hit.Instance
                    break
                end
            end
        end
        if not pos or not alvo then
            -- ultimo recurso: punto delante y Activate igual
            pos = hrp.Position + dir * 18 + Vector3.new(0, -2, 0)
            alvo = workspace.Terrain
            pcall(function()
                if tool.Activate then tool:Activate() end
            end)
            pcall(function()
                if firesignal and tool.Activated then firesignal(tool.Activated) end
            end)
            pcall(function()
                if type(useToolInHand) == "function" then useToolInHand(tool) end
            end)
            return true
        end
        return disparar(tool, pos, alvo, char)
    end
end

