function BS.setBaseState(plot, newState)
    local m = BS.mem[plot.Name]
    if not m then
        BS.mem[plot.Name] = { state = newState, pend = nil, since = 0 }
        return
    end
    if m.state == newState then m.pend = nil return end
    -- debounce 0.6s para evitar parpadeos
    if m.pend ~= newState then m.pend = newState; m.since = tick() return end
    if tick() - m.since >= 0.6 then
        m.state = newState
        m.pend = nil
        local who = BS.plotOwnerName(plot)
        if newState == "open" then
            BS.baseToast(who .. " ABRIO su base", Color3.fromRGB(80, 230, 120))
        else
            BS.baseToast(who .. " CERRO su base", Color3.fromRGB(255, 90, 90))
        end
    end
end

