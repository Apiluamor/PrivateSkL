    local function readGameCd(cmdName)
        local best = nil
        pcall(function()
            local ap = LocalPlayer.PlayerGui:FindFirstChild("AdminPanel")
            if not ap then return end
            local inner = ap:FindFirstChild("AdminPanel")
            if not inner then return end
            local content = inner:FindFirstChild("Content")
            if not content then return end
            local sf = content:FindFirstChild("ScrollingFrame") or content
            local target = string.lower(cmdName)
            for _, d in ipairs(sf:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    local t = string.lower(tostring(d.Text or ""))
                    -- ej: ";rocket 119s" / "ro119s" / "jail 55s"
                    if t:find(target, 1, true) or (target == "rocket" and t:find("ro"))
                        or (target == "ragdoll" and t:find("ra"))
                        or (target == "balloon" and t:find("ba"))
                        or (target == "tiny" and t:find("ti"))
                        or (target == "jail" and t:find("ja")) then
                        local sec = t:match("(%d+)%s*s") or t:match("(%d+)")
                        if sec then
                            local n = tonumber(sec)
                            if n and n > 0 and n < 600 then
                                if not best or n > best then best = n end
                            end
                        end
                    end
                end
            end
        end)
