local function performReset()
    -- Insta Reset integrado: boton RESET + Reset On Balloon.
    if resetting then return end

    local character = LocalPlayer.Character
    if not character or not character.Parent then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    resetting = true
    isResettingFast = true

    -- Evitar que Reset On Balloon vuelva a dispararse en bucle.
    pcall(function()
        LocalPlayer:SetAttribute("Balloon", false)
        character:SetAttribute("Balloon", false)
    end)

    local camera = Workspace.CurrentCamera
    local lockedCFrame = camera and camera.CFrame or nil
    local originalHipHeight = humanoid.HipHeight
    if type(originalHipHeight) ~= "number" or originalHipHeight > 10 or originalHipHeight < 0 then
        originalHipHeight = 2
    end

    task.spawn(function()
        local resetSuccessful = false
        local attempts = 0
        local maxAttempts = 40

        -- Mantener la camara fija mientras se completa el reset.
        if camera and lockedCFrame then
            pcall(function()
                camera.CameraType = Enum.CameraType.Scriptable
                camera.CFrame = lockedCFrame
            end)
        end

        while character and character.Parent
            and humanoid and humanoid.Health > 0
            and LocalPlayer.Character == character
            and attempts < maxAttempts do

            pcall(function()
                humanoid.HipHeight = 1e30
                humanoid.AutoRotate = true

                local root = character:FindFirstChild("HumanoidRootPart")
                if root then root.CanCollide = false end

                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end
            end)

            if LocalPlayer.Character ~= character or not character.Parent or humanoid.Health <= 0 then
                resetSuccessful = true
                break
            end

            attempts += 1
            if camera and lockedCFrame then
                pcall(function() camera.CFrame = lockedCFrame end)
            end
            task.wait(0.05)
        end

        -- Si el metodo rapido no provoco el respawn, forzar la muerte local.
        if not resetSuccessful and character and character.Parent and humanoid and humanoid.Health > 0 then
            pcall(function() humanoid.Health = 0 end)
            task.wait(0.1)
            if not character.Parent or humanoid.Health <= 0 or LocalPlayer.Character ~= character then
                resetSuccessful = true
            end
        end

        -- Restaurar propiedades si el personaje no llego a reiniciarse.
        if not resetSuccessful and character and character.Parent and humanoid then
            pcall(function()
                humanoid.HipHeight = originalHipHeight
                humanoid.PlatformStand = false
                humanoid.AutoRotate = true
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then root.CanCollide = true end
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = true
                    end
                end
            end)
        end

        -- Restaurar la camara al personaje actual y liberar el bloqueo.
        task.delay(0.15, function()
            pcall(function()
                local cam = Workspace.CurrentCamera
                local newCharacter = LocalPlayer.Character
                local newHumanoid = newCharacter and newCharacter:FindFirstChildOfClass("Humanoid")
                if cam then
                    cam.CameraType = Enum.CameraType.Custom
                    if newHumanoid then cam.CameraSubject = newHumanoid end
                end
            end)
            resetting = false
            isResettingFast = false
            pcall(function() _flashBlockBusy = false end)
        end)
    end)
end

local function instantReset()
    pcall(performReset)
end

local function doReset()
    pcall(performReset)
end

