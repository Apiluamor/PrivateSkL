-- Aplica vidrio a las "ventanas" de una ScreenGui (para todas las GUI del script)
_G._175_GlassGui = function(gui)
    local vp = workspace.CurrentCamera.ViewportSize
    local function consider(f, depth)
        if not f:IsA("Frame") or f.Name == "GlassClip" then return end
        local sz = f.AbsoluteSize
        if sz.X >= vp.X * 0.9 and sz.Y >= vp.Y * 0.9 then
            if depth < 2 then for _, c in ipairs(f:GetChildren()) do consider(c, depth + 1) end end
            return
        end
        if f.BackgroundTransparency >= 0.95 or sz.X < 80 or sz.Y < 28 then
            if depth < 2 and (f.BackgroundTransparency >= 0.95 or (sz.X == 0 and sz.Y == 0)) then
                for _, c in ipairs(f:GetChildren()) do consider(c, depth + 1) end
            end
            return
        end
        _G._175_ApplyGlass(f, (f:FindFirstChildOfClass("UICorner") and f:FindFirstChildOfClass("UICorner").CornerRadius) or UDim.new(0, 10))
    end
    for _, c in ipairs(gui:GetChildren()) do consider(c, 0) end
end

