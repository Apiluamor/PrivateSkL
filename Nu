                if type(getBlockDelay) == "function" then
                    waitT = math.max(0.9, tonumber(getBlockDelay()) or 0.9)
                end
            end)
            waitT = tonumber(waitT) or 0.9
            if waitT < 0.9 then waitT = 0.9 end
            if waitT > 3 then waitT = 3 end
            print("[175] AutoBlock wait", waitT, "mode", tostring(_G.BlockDelay))
            task.wait(waitT)
        end
        if not _G.AutoBlock then releaseBlockGuard(); return end
        local target = nil
        pcall(function() target = getNearestPlayer() end)
        if not target then
            local me = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local best, bestD = nil, 400
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local h = p.Character:FindFirstChild("HumanoidRootPart")
                    if h then
                        local d = me and (h.Position - me.Position).Magnitude or 0
                        if d < bestD then bestD, best = d, p end
                    end
                end
            end
            target = best
        end
        if not target then
            print("[175] AutoBlock: no hay jugadores")
            releaseBlockGuard()
            return
        end
        print("[175] AutoBlock →", target.Name, "mode", tostring(_G.BlockDelay))
        -- Una sola solicitud por activacion: evita abrir dos dialogos
        -- seguidos y no interrumpe la secuencia de Auto Grab.
        pcall(blockPlayer, target)
        task.wait(0.05)
        pcall(function()
            if type(_confirmBlockDialog) == "function" then
                _confirmBlockDialog(0.35)
            end
        end)
        releaseBlockGuard()
    end)
end

