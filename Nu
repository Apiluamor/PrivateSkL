local function getNearestPlayerAimbot(maxRange)
    maxRange = maxRange or aimbotRange
    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local myPos = myHRP.Position
    local nearest, shortest = nil, maxRange
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")
            local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = pl
                end
            end
        end
    end
    return nearest
end

local function getAimPart(target)
    if not target or not target.Character then return nil end
    -- Head = más hit; fallback HRP
    return target.Character:FindFirstChild("Head")
        or target.Character:FindFirstChild("HumanoidRootPart")
        or target.Character:FindFirstChild("UpperTorso")
end

-- Predicción simple de movimiento (persigue)
local function predictPos(part)
    if not part then return nil end
    local pos = part.Position
    local vel = Vector3.zero
    pcall(function()
        vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    end)
    -- adelanta ~0.12s el movimiento del enemigo
    return pos + vel * 0.12
end

local function fireAimRemote(pos, part, handle)
    if not aimbotRemote or not aimbotFireRemote then return end
    pcall(function()
        if handle then
            aimbotFireRemote(aimbotRemote, pos, part, handle)
        else
            aimbotFireRemote(aimbotRemote, pos, part)
        end
    end)
end

local function useLaserCapeAimbot(targetPart)
    if not targetPart then return end
    local pos = predictPos(targetPart) or targetPart.Position
    -- multi-hit para no fallar
    for _ = 1, 3 do
        fireAimRemote(pos, targetPart)
        fireAimRemote(targetPart.Position, targetPart)
    end
end

local function useWebSlingerAimbot(targetPart)
    if not targetPart then return end
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local tool = (char and char:FindFirstChild("Web Slinger")) or (bp and bp:FindFirstChild("Web Slinger"))
    local handle = tool and tool:FindFirstChild("Handle")
    local pos = predictPos(targetPart) or targetPart.Position
    for _ = 1, 2 do
        fireAimRemote(pos, targetPart, handle)
        fireAimRemote(targetPart.Position, targetPart, handle)
    end
end

local function usePaintballAimbot(targetPart)
    if not targetPart then return end
    local pos = predictPos(targetPart) or targetPart.Position
    for _ = 1, 4 do
        fireAimRemote(pos, targetPart)
        fireAimRemote(targetPart.Position, targetPart)
    end
end

local function fireAimbotAtNearest()
    if not aimbotEnabled then return end
    local target = getNearestPlayerAimbot(aimbotRange)
    if not target then return end
    local part = getAimPart(target)
    if not part then return end
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local n = string.lower(tool.Name or "")
    if n:find("laser", 1, true) then
        useLaserCapeAimbot(part)
    elseif n:find("web", 1, true) or n:find("slinger", 1, true) then
        useWebSlingerAimbot(part)
    elseif n:find("paintball", 1, true) or n:find("paint", 1, true) then
        usePaintballAimbot(part)
    else
        useLaserCapeAimbot(part)
    end
end

local function setupLaserAimAimbot()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local laserTool = (char and char:FindFirstChild("Laser Cape")) or (bp and bp:FindFirstChild("Laser Cape"))
