                end
            end
        end)
        if found then
            for _, sigName in ipairs({"Activated", "MouseButton1Click"}) do
                pcall(function()
                    if getconnections then
                        for _, c in ipairs(getconnections(found[sigName])) do pcall(function() c:Fire() end) end
                    elseif firesignal then
                        firesignal(found[sigName])
                    end
                end)
            end
            return true
        end
        RunService.Heartbeat:Wait()
