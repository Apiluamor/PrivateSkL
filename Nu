local function doQuickFlashAndGrab()
    -- Flash + auto grab mejorado (mas intentos, hold mas estable)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum then return end

        -- NO block aqui (solo AutoBlock en llegada) — no interferir grab
        local flash = nil
        pcall(function() flash = findTool("flash") end)
        if flash then
            pcall(function()
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            pcall(function() hum:EquipTool(flash) end)
            task.wait(0.08)
            -- No abrir el diálogo de AutoBlock antes del agarre; puede interrumpir el prompt.
            pcall(function() flash:Activate() end)
            task.wait(0.05)
            pcall(function()
            end)
            task.wait(0.10)
        end

        local prompt = selectedPrompt
        if not prompt or not prompt.Parent then
            if type(livePetPrompts) == "table" then
                for _, data in pairs(livePetPrompts) do
                    if data and data.prompt and data.prompt.Parent then
                        prompt = data.prompt
                        selectedPrompt = prompt
                        selectedSlotNumber = data.slot
                        break
                    end
                end
            end
        end
        if not prompt or not prompt.Parent then return end

        -- Acercar al prompt
        pcall(function()
            if hrp and prompt.Parent then
                local att = prompt.Parent
                local pos = nil
                if att:IsA("Attachment") then
                    pos = att.WorldPosition
                elseif att:IsA("BasePart") then
                    pos = att.Position
                end
                if pos then
                    local dir = (pos - hrp.Position)
                    if dir.Magnitude > 6 then
                        -- Un solo ajuste corto evita saltos grandes y giros al llegar.
                        local step = math.min(5, math.max(0, dir.Magnitude - 4))
                        if step > 0 then
                            hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * step)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end
        end)

        isStealing = false
        local hold = 0.12
        pcall(function()
            if prompt.HoldDuration and prompt.HoldDuration > 0 then
                hold = math.clamp(prompt.HoldDuration, 0.08, 0.45)
            end
        end)

        -- Bajar HoldDuration temporal si se puede
        local origHold = nil
        pcall(function()
            origHold = prompt.HoldDuration
            prompt.HoldDuration = 0.05
            hold = 0.06
        end)
        pcall(function()
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = math.huge
        end)

        for attempt = 1, 3 do
            pcall(function()
                if fireproximityprompt then
                    fireproximityprompt(prompt, hold)
                    fireproximityprompt(prompt)
                end
            end)
            pcall(function()
                if getconnections then
                    for _, signalName in ipairs({"PromptButtonHoldBegan", "Triggered", "PromptButtonHoldEnded"}) do
                        local ok, cons = pcall(function() return getconnections(prompt[signalName]) end)
                        if ok and cons then
                            for _, conn in ipairs(cons) do
                                if conn.Function then task.spawn(conn.Function) end
                                if conn.Fire then pcall(function() conn:Fire() end) end
                            end
                        end
                    end
                end
            end)
            pcall(function() prompt:InputHoldBegin() end)
            task.wait(hold)
            pcall(function() prompt:InputHoldEnd() end)
            task.wait(0.05)
            -- si el prompt desaparecio, probablemente ya agarro
            if not prompt.Parent or not prompt.Enabled then break end
        end

        pcall(function()
            if origHold ~= nil and prompt and prompt.Parent then
                prompt.HoldDuration = origHold
            end
        end)

        task.wait(0.08)
        pcall(function() hum:UnequipTools() end)
        isStealing = false
    end)
end


