_G._175_MakeResizable = function(frame, minW, minH, maxW, maxH, extra)
    if not frame or not frame:IsA("GuiObject") then return end
    if frame:FindFirstChild("175_ResizeGrip") then return end
    minW = minW or 100
    minH = minH or 60
    maxW = maxW or 700
    maxH = maxH or 900
    extra = extra or {}
    -- tamano por defecto (antes de restaurar el guardado): base para escalar el contenido
    local defW, defH = frame.Size.X.Offset, frame.Size.Y.Offset
    if frame.Size.X.Scale ~= 0 or frame.Size.Y.Scale ~= 0 or defW < 20 or defH < 20 then
        defW, defH = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
    end
    if frame:GetAttribute("_175DefW") then
        defW, defH = frame:GetAttribute("_175DefW"), frame:GetAttribute("_175DefH") or defH
    end
    if defW < 20 then defW = minW end
    if defH < 20 then defH = minH end
    -- restaurar tamaño si hay key
    if extra.layoutKey and type(applySavedPos) == "function" then
        pcall(function()
            local s = uiLayout and uiLayout[extra.layoutKey]
            if s and type(s.w) == "number" and s.w > 40 then
                frame.Size = UDim2.fromOffset(s.w, s.h or minH)
            end
        end)
    end
    local grip = Instance.new("TextButton")
    grip.Name = "175_ResizeGrip"
    grip.Size = UDim2.fromOffset(24, 24)
    grip.Position = UDim2.new(1, -24, 1, -24)
    grip.ZIndex = 250
    grip.Parent = frame
    _G._175_StyleGrip(grip, 24)
    local resizing, origin, base = false, nil, nil
    local baseTextSizes = {} -- [GuiObject] = original TextSize
    local function captureTextSizes()
        baseTextSizes = {}
        pcall(function()
            for _, d in ipairs(frame:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    baseTextSizes[d] = d.TextSize
                end
            end
        end)
        -- baseline size for scale ratio
        if not frame:GetAttribute("_175_BaseW") then
            frame:SetAttribute("_175_BaseW", frame.AbsoluteSize.X)
            frame:SetAttribute("_175_BaseH", frame.AbsoluteSize.Y)
        end
    end
    captureTextSizes()
    local function applyScale(nw, nh)
        _G._175_ScaleContent(frame, math.min(nw / defW, nh / defH))
    end
    do -- si el tamano guardado es distinto al base, escalar al abrir
        local sw, sh = frame.Size.X.Offset, frame.Size.Y.Offset
        if sw > 20 and sh > 20 and (math.abs(sw - defW) > 1 or math.abs(sh - defH) > 1) then
            task.defer(function() pcall(applyScale, sw, sh) end)
        end
    end
    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            origin = Vector2.new(input.Position.X, input.Position.Y)
            base = frame.AbsoluteSize
            if next(baseTextSizes) == nil then captureTextSizes() end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if resizing then
                resizing = false
                -- guardar tamaño
                if extra.layoutKey and type(persistPos) == "function" then
                    pcall(persistPos, frame, extra.layoutKey)
                elseif extra.layoutKey and uiLayout then
                    uiLayout[extra.layoutKey] = uiLayout[extra.layoutKey] or {}
                    uiLayout[extra.layoutKey].w = frame.AbsoluteSize.X
                    uiLayout[extra.layoutKey].h = frame.AbsoluteSize.Y
                    if type(saveUILayout) == "function" then pcall(saveUILayout) end
                end
                if extra.border and extra.layoutKey then
                    -- también guardar border si es main
                end
            else
                resizing = false
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not resizing or not frame.Parent then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = Vector2.new(input.Position.X, input.Position.Y) - origin
        local nw = math.clamp(base.X + d.X, minW, maxW)
        local nh = math.clamp(base.Y + d.Y, minH, maxH)
        frame.Size = UDim2.fromOffset(nw, nh)
        if extra.border then
            extra.border.Size = UDim2.fromOffset(nw + (extra.pad or 4), nh + (extra.pad or 4))
        end
        if extra.inner then
            extra.inner.Size = UDim2.fromOffset(nw - (extra.pad or 4), nh - (extra.pad or 4))
        end
        pcall(applyScale, nw, nh)
        if extra.onResize then pcall(extra.onResize, nw, nh) end
    end)
end


